# API bearer token — required for all /v1/* endpoints and web UI login
RUNPIN_API_KEY=change-me-to-a-long-secret

# SQLite database path (shared by API + worker)
DATABASE_PATH=./data/runpin.db

# HTTP listen port
PORT=3000

# Worker polling / lease settings
WORKER_POLL_MS=1000
WORKER_LEASE_SEC=60
WORKER_HEARTBEAT_SEC=20
WORKER_ID=worker-1
# Max jobs this worker runs in parallel (default 1 = serial)
WORKER_CONCURRENCY=1

# Scheduler tick interval (ms)
SCHEDULER_TICK_MS=15000

# Optional: vendor handlers — job types implemented by a module installed next to
# the worker. Set on api + worker; the module itself ships in vendor/ (gitignored).
# See docs/VENDOR-HANDLERS.md
# VENDOR_HANDLERS={"acme.report":{"module":"@acme/report-runner","export":"runReportJob","title":"Report runner","max_attempts":20,"max_duration_sec":1200}}

# Optional: real Google Drive upload for save_to_google_drive actions
# GOOGLE_DRIVE_FOLDER_ID=your-folder-id
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# Or path to a JSON key file:
# GOOGLE_SERVICE_ACCOUNT_JSON=./secrets/google-sa.json

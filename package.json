{
  "name": "runpin",
  "version": "0.1.0",
  "description": "Self-hosted durable job runner — long AI jobs, cron, and operator UI",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "tsc && npm run build:web",
    "build:web": "vite build --config web/vite.config.ts",
    "start:api": "node dist/api/index.js",
    "start:worker": "node dist/worker/index.js",
    "dev": "tsx watch src/api/index.ts",
    "dev:api": "tsx watch src/api/index.ts",
    "dev:worker": "tsx watch src/worker/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "seed:demo": "tsx scripts/seed-demo.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "better-sqlite3": "^11.7.0",
    "cron-parser": "^4.9.0",
    "hono": "^4.6.14",
    "nanoid": "^5.0.9",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.6"
  }
}
